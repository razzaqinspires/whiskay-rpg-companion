# Bot-to-website RPG snapshot integration. Never expose service-role secrets to client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Match this token with DUNGEON_SYNC_TOKEN in the bot deployment.
BOT_SYNC_TOKEN=
NEXT_PUBLIC_GAME_TITLE=WHISKAY RPG
# Optional rigged 3D models. Leave blank to use built-in procedural fallback models.
# Host optimized GLB files under public/assets/models or use absolute HTTPS URLs.
NEXT_PUBLIC_HERO_GLB_URL=
NEXT_PUBLIC_MONSTER_GLB_URL=
# Same secret configured as DUNGEON_SYNC_TOKEN in the WhatsApp bot deployment.
BOT_SYNC_TOKEN=
