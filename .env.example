# Public site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side signing/sync secrets: set real values in deployment environment only.
BOT_SYNC_TOKEN=replace-with-a-random-secret
DUNGEON_SYNC_TOKEN=replace-with-a-random-secret
WHISKAY_BOSS_WEBHOOK_SECRET=replace-with-a-random-secret

# Optional public URL to a secret-free Quick Tunnel manifest.
WHISKAY_TUNNEL_MANIFEST_URL=

# Optional server-side database configuration. Never commit actual credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
