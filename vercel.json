{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    }
  ],
  "rewrites": [
    {"source": "/dungeon", "destination": "/dungeon.html"},
    {"source": "/inventory", "destination": "/inventory.html"}
  ]
}
