{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/inventory",
      "destination": "/inventory.html"
    },
    {
      "source": "/dungeon",
      "destination": "/index.html"
    }
  ]
}
